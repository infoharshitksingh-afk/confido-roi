# Copy to .env.local for `vercel dev`, or set these in Vercel → Project → Settings → Environment Variables.
# Never commit a real key.

# Optional. If set, the site uses this key server-side and visitors don't paste their own.
# Leave it unset for "bring your own key" mode.
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# Optional. If set (with a server key), visitors must enter this code before Claude runs,
# so a public link can't spend your credits.
ACCESS_CODE=
